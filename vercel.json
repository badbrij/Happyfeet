{
  "version": 2,
  "name": "badakadam-pwa",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/frontend/sw.js",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/manifest.json"
    },
    {
      "src": "/BadaKadam.apk",
      "dest": "/frontend/BadaKadam.apk",
      "headers": {
        "content-type": "application/vnd.android.package-archive",
        "content-disposition": "attachment; filename=\"BadaKadam_Fitness.apk\"",
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)\\.apk$",
      "dest": "/frontend/$1.apk",
      "headers": {
        "content-type": "application/vnd.android.package-archive",
        "content-disposition": "attachment; filename=\"BadaKadam_Fitness.apk\"",
        "cache-control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
